# SecurePass AI — Environment Variables Template
# ────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values. .env is gitignored.
# ────────────────────────────────────────────────────────────────────────────

FLASK_ENV=development
FLASK_APP=app.py

# ── Security keys ───────────────────────────────────────────────────────────
# Generate both with: python -c "import secrets; print(secrets.token_hex(32))"
# Keep SECRET_KEY and JWT_SECRET_KEY distinct — rotating one should not
# force rotating the other.
SECRET_KEY=
JWT_SECRET_KEY=

# ── Database — Supabase PostgreSQL ──────────────────────────────────────────
#
# Development default (no setup required — uses local SQLite):
DATABASE_URL=sqlite:///securepass.db
#
# ┌─ SUPABASE SETUP ──────────────────────────────────────────────────────┐
# │  1. Create a free project at https://supabase.com                     │
# │  2. Go to: Settings → Database → Connection string → URI tab          │
# │  3. Switch to the TRANSACTION POOLER tab (port 6543, not 5432)        │
# │     ✓ Transaction pooler = PgBouncer in transaction mode              │
# │       → safe for multi-worker Flask (Render/Railway/Fly)              │
# │     ✗ Session pooler (port 5432) — avoid for web apps                 │
# │     ✗ Direct connection (port 5432) — exhausts connections quickly    │
# │  4. Copy the URI and paste below                                       │
# └───────────────────────────────────────────────────────────────────────┘
#
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# After setting DATABASE_URL, run migrations:
#   flask db upgrade

# ── Redis — JWT blocklist + rate limiting ───────────────────────────────────
# Development default (requires local Redis):
REDIS_URL=redis://localhost:6379/0
#
# Free cloud option — Upstash Redis (https://upstash.com):
# REDIS_URL=rediss://default:[PASSWORD]@[HOST].upstash.io:6379
#
# Note: Supabase does NOT provide Redis — use Upstash or Railway Redis.

# ── Rate limiting ────────────────────────────────────────────────────────────
# Falls back to REDIS_URL if not set separately.
# Accepts redis:// or rediss:// URLs (rediss:// enables TLS automatically).
# Upstash:  RATELIMIT_STORAGE_URL=rediss://default:[PASSWORD]@[HOST].upstash.io:6379
# Railway:  RATELIMIT_STORAGE_URL=redis://[RAILWAY-REDIS-URL]:6379
RATELIMIT_STORAGE_URL=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowlist of exact frontend origins (scheme + host + port).
# No wildcards — every origin must be listed explicitly.
# Production example: CORS_ORIGINS=https://yourapp.vercel.app,https://yourapp.com
CORS_ORIGINS=http://localhost:5173

# ── Cookie security ───────────────────────────────────────────────────────────
# Not read from here — SESSION_COOKIE_SECURE, REMEMBER_COOKIE_SECURE, and
# JWT_COOKIE_SECURE are hardcoded per environment in config.py
# (DevelopmentConfig / ProductionConfig) so this can't be misconfigured by
# a missing or wrong env var: False in dev, always True in production
# regardless of what's set here.

# ── Groq AI — optional ───────────────────────────────────────────────────────
# Powers AI-generated policy recommendations (backend/ai_engine.py)
# Free tier at https://console.groq.com
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
