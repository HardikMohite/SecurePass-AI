# SecurePass AI — Frontend environment variables
# Copy this file to .env (or .env.local) for local dev. Vite only exposes
# variables prefixed with VITE_ to client code (import.meta.env.*).

# Base URL of the backend API, no trailing slash. src/api.js prefixes
# every request with this value.
#   - Leave empty to use same-origin relative paths (e.g. behind a proxy
#     or when the frontend is served by the Flask app itself).
#   - Point at the local Flask dev server when running `vite dev`
#     against a backend on a different port:
VITE_API_BASE_URL=http://localhost:5000
